# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Nenhuma variável aqui exige serviço pago para rodar o projeto localmente.

# --- Banco de dados (PostgreSQL via Docker Compose) ---
POSTGRES_USER=apea
POSTGRES_PASSWORD=apea_dev_password
POSTGRES_DB=apea
POSTGRES_PORT=5432

DATABASE_URL="postgresql://apea:apea_dev_password@localhost:5432/apea?schema=public"

# --- Autenticação (Auth.js) ---
# Gere um valor com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="troque-este-valor-em-producao-com-uma-chave-aleatoria"
NEXTAUTH_URL="http://localhost:3000"

# --- Tutor de IA / AI Gateway (tudo opcional) ---
# Sem nenhuma chave configurada, o Gateway usa o MockAIProvider para toda tarefa (100% local,
# respostas heurísticas determinísticas, sem chamada externa). Configure só as chaves dos
# providers que quiser ativar — os demais continuam caindo no mock automaticamente.
# Roteamento por tarefa: ensino -> AI_TEACHING_PROVIDER (openai|claude, padrão openai);
# revisão de código -> sempre Claude; resumo de conteúdo longo -> sempre Gemini.
AI_TEACHING_PROVIDER=openai

AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=claude-sonnet-5

AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-flash-latest

# --- Sincronização do Portfólio com o GitHub (opcional) ---
# A API pública do GitHub funciona sem token para repositórios públicos (limite de 60
# requisições/hora por IP). Defina um Personal Access Token (sem escopos, "public_repo" já basta)
# só se esbarrar nesse limite com muitos alunos sincronizando ao mesmo tempo.
GITHUB_TOKEN=

# --- Diversos ---
NODE_ENV=development
