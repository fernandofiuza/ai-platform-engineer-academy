# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Nenhuma variável aqui exige serviço pago para rodar o projeto localmente.

# --- Banco de dados (PostgreSQL via Docker Compose) ---
POSTGRES_USER=apea
POSTGRES_PASSWORD=apea_dev_password
POSTGRES_DB=apea
POSTGRES_PORT=5432

DATABASE_URL="postgresql://apea:apea_dev_password@localhost:5432/apea?schema=public"

# --- Autenticação (Auth.js) ---
# Gere um valor com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="troque-este-valor-em-producao-com-uma-chave-aleatoria"
NEXTAUTH_URL="http://localhost:3000"

# --- Tutor de IA (opcional) ---
# AI_PROVIDER=mock roda 100% local, sem chave, com respostas heurísticas determinísticas.
# AI_PROVIDER=openai ativa o provider real (chamado sempre no servidor, nunca no client).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Diversos ---
NODE_ENV=development
