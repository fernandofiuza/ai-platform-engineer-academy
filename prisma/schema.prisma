// AI Platform Engineer Academy — Prisma schema
// Fase 1: identidade/acesso. Fase 2: currículo (Program..Lesson) + importação de Curso.md.
// Track/Module, Technology/Skill, Activity/Checkpoint ficam para quando houver conteúdo real
// para popular esses níveis (ver docs/DECISIONS.md — "Fase 2: schema mínimo por entrega vertical").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile               Profile?
  passwordResetTokens   PasswordResetToken[]
  checklistItemProgress ChecklistItemProgress[]
  lessonCompletions     LessonCompletion[]
  studyPlan             StudyPlan?
  studyGoals            StudyGoal[]
  studySessions         StudySession[]
  notes                 Note[]
  assessmentAttempts    AssessmentAttempt[]
  flashcardReviews      FlashcardReview[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  avatarUrl   String?
  timezone    String   @default("America/Sao_Paulo")
  bio         String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Currículo (Fase 2)
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PLANNED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ResourceKind {
  DOC
  VIDEO
  ARTICLE
  REPO
  OTHER
}

model Program {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  subtitle       String?
  durationMonths Int
  totalWeeks     Int
  weeklyDays     Int
  dailyHours     Float
  status         ContentStatus @default(AVAILABLE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  phases Phase[]
  weeks  Week[]

  @@map("programs")
}

model Phase {
  id        String        @id @default(cuid())
  programId String
  order     Int
  name      String
  label     String
  status    ContentStatus @default(PLANNED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  weeks   Week[]

  @@unique([programId, order])
  @@map("phases")
}

model Week {
  id                 String        @id @default(cuid())
  programId          String
  phaseId            String?
  number             Int
  title              String
  objective          String?
  isEnvironmentSetup Boolean       @default(false)
  status             ContentStatus @default(PLANNED)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  phase          Phase?          @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  lessons        Lesson[]
  checklistItems ChecklistItem[]
  studyGoals     StudyGoal[]

  @@unique([programId, number])
  @@index([phaseId])
  @@map("weeks")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  weekId    String
  category  String
  label     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week     Week                    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  statuses ChecklistItemProgress[]

  @@unique([weekId, category, label])
  @@map("checklist_items")
}

model ChecklistItemProgress {
  id               String    @id @default(cuid())
  userId           String
  checklistItemId  String
  done             Boolean   @default(false)
  note             String?
  evidenceUrl      String?
  installedVersion String?
  reviewNeeded     Boolean   @default(false)
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistItemId])
  @@map("checklist_item_progress")
}

model Lesson {
  id              String        @id @default(cuid())
  weekId          String
  order           Int
  title           String
  objective       String?
  durationMinutes Int?
  contentMarkdown String?
  isDemo          Boolean       @default(false)
  status          ContentStatus @default(PLANNED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  week        Week               @relation(fields: [weekId], references: [id], onDelete: Cascade)
  resources   Resource[]
  completions LessonCompletion[]
  sessions    StudySession[]
  assessments Assessment[]
  flashcards  Flashcard[]

  @@unique([weekId, order])
  @@map("lessons")
}

model Resource {
  id        String       @id @default(cuid())
  lessonId  String
  title     String
  url       String
  kind      ResourceKind @default(OTHER)
  createdAt DateTime     @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("resources")
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  confidence  Int?
  whatLearned String?
  whatUnclear String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_completions")
}

// ---------------------------------------------------------------------------
// Importação de Curso.md (Fase 2)
// ---------------------------------------------------------------------------

model ImportJob {
  id           String    @id @default(cuid())
  sourceFile   String
  contentHash  String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdCount Int       @default(0)
  updatedCount Int       @default(0)
  skippedCount Int       @default(0)
  report       Json?

  warnings ImportWarning[]

  @@index([contentHash])
  @@map("import_jobs")
}

model ImportWarning {
  id               String  @id @default(cuid())
  importJobId      String
  excerpt          String
  reason           String
  targetEntityHint String?
  needsReview      Boolean @default(true)

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_warnings")
}

// ---------------------------------------------------------------------------
// Aprendizagem (Fase 3): planejamento, sessões, metas, anotações, avaliações,
// flashcards. Progresso agregado é calculado sob demanda via queries (COUNT),
// sem tabela `Progress` própria — ver docs/DECISIONS.md.
// ---------------------------------------------------------------------------

enum GoalStatus {
  OPEN
  DONE
  CANCELLED
}

model StudyPlan {
  id            String   @id @default(cuid())
  userId        String   @unique
  availableDays Int[]    @default([1, 2, 3, 4, 5])
  preferredTime String?
  dailyHours    Float    @default(3.5)
  startDate     DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_plans")
}

model StudyGoal {
  id            String     @id @default(cuid())
  userId        String
  title         String
  targetDate    DateTime?
  relatedWeekId String?
  status        GoalStatus @default(OPEN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedWeek Week? @relation(fields: [relatedWeekId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("study_goals")
}

model StudySession {
  id                 String    @id @default(cuid())
  userId             String
  lessonId           String?
  startedAt          DateTime  @default(now())
  pausedAt           DateTime?
  totalPausedSeconds Int       @default(0)
  endedAt            DateTime?
  durationMinutes    Int?
  focusRating        Int?
  difficultyRating   Int?
  notes              String?
  completedContent   Boolean   @default(false)
  createdAt          DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("study_sessions")
}

enum NoteScope {
  LESSON
  WEEK
  GENERAL
}

enum NoteTemplate {
  SUMMARY
  QUESTION
  DECISION
  TROUBLESHOOTING
  RETROSPECTIVE
  CONCEPT
  COMMAND
}

model Note {
  id              String       @id @default(cuid())
  userId          String
  scopeType       NoteScope    @default(GENERAL)
  scopeId         String?
  template        NoteTemplate @default(SUMMARY)
  title           String
  contentMarkdown String
  tags            String[]     @default([])
  isFavorite      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notes")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Assessment {
  id        String        @id @default(cuid())
  lessonId  String?
  title     String
  status    ContentStatus @default(AVAILABLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lesson    Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  AssessmentAttempt[]

  @@map("assessments")
}

model Question {
  id           String       @id @default(cuid())
  assessmentId String
  order        Int
  prompt       String
  type         QuestionType
  explanation  String?

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    AnswerOption[]

  @@unique([assessmentId, order])
  @@map("questions")
}

model AnswerOption {
  id         String  @id @default(cuid())
  questionId String
  order      Int
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("answer_options")
}

model AssessmentAttempt {
  id               String    @id @default(cuid())
  userId           String
  assessmentId     String
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  score            Float?
  answers          Json?
  timeSpentSeconds Int?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId])
  @@map("assessment_attempts")
}

model Flashcard {
  id         String   @id @default(cuid())
  lessonId   String?
  question   String
  answer     String
  difficulty Int      @default(2)
  tags       String[] @default([])
  createdAt  DateTime @default(now())

  lesson  Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  reviews FlashcardReview[]

  @@map("flashcards")
}

model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  flashcardId  String
  reviewedAt   DateTime @default(now())
  quality      Int
  nextReviewAt DateTime
  intervalDays Int      @default(1)
  easeFactor   Float    @default(2.5)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
  @@map("flashcard_reviews")
}
