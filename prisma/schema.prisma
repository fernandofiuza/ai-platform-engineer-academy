// AI Platform Engineer Academy — Prisma schema
// Fase 1: identidade/acesso. Fase 2: currículo (Program..Lesson) + importação de Curso.md.
// Track/Module, Technology/Skill, Activity/Checkpoint ficam para quando houver conteúdo real
// para popular esses níveis (ver docs/DECISIONS.md — "Fase 2: schema mínimo por entrega vertical").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile               Profile?
  passwordResetTokens   PasswordResetToken[]
  checklistItemProgress ChecklistItemProgress[]
  lessonCompletions     LessonCompletion[]
  studyPlan             StudyPlan?
  studyGoals            StudyGoal[]
  studySessions         StudySession[]
  notes                 Note[]
  assessmentAttempts    AssessmentAttempt[]
  flashcardReviews      FlashcardReview[]
  skillProgress         UserSkillProgress[]
  portfolioItems        PortfolioItem[]
  badges                UserBadge[]
  experienceEvents      ExperienceEvent[]
  projectSubmissions    ProjectSubmission[]
  laboratoryCompletions LaboratoryCompletion[]
  aiConversations       AIConversation[]
  certifications        Certification[]

  @@map("users")
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  avatarUrl         String?
  timezone          String   @default("America/Sao_Paulo")
  bio               String?
  preferences       Json?
  manualCommitCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Currículo (Fase 2)
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PLANNED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ResourceKind {
  DOC
  VIDEO
  ARTICLE
  REPO
  OTHER
}

model Program {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  subtitle       String?
  durationMonths Int
  totalWeeks     Int
  weeklyDays     Int
  dailyHours     Float
  status         ContentStatus @default(AVAILABLE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  phases Phase[]
  weeks  Week[]

  @@map("programs")
}

model Phase {
  id                String        @id @default(cuid())
  programId         String
  order             Int
  name              String
  label             String
  status            ContentStatus @default(PLANNED)
  finalProjectId    String?       @unique
  finalAssessmentId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  program         Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  weeks           Week[]
  finalProject    Project?        @relation(fields: [finalProjectId], references: [id], onDelete: SetNull)
  finalAssessment Assessment?     @relation(fields: [finalAssessmentId], references: [id], onDelete: SetNull)
  certifications  Certification[]

  @@unique([programId, order])
  @@map("phases")
}

// Etapa 8: certificação interna por semestre (não é uma certificação de mercado). Emitida quando
// o estudante conclui todas as semanas obrigatórias do semestre + o projeto final do semestre +
// a avaliação final do semestre (ambos definidos pela área administrativa via `Phase.finalProject`/
// `finalAssessment` — ver docs/DECISIONS.md).
model Certification {
  id       String   @id @default(cuid())
  userId   String
  phaseId  String
  code     String   @unique
  issuedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase Phase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([userId, phaseId])
  @@map("certifications")
}

model Week {
  id                 String        @id @default(cuid())
  programId          String
  phaseId            String?
  number             Int
  title              String
  objective          String?
  isEnvironmentSetup Boolean       @default(false)
  isManuallyEdited   Boolean       @default(false)
  status             ContentStatus @default(PLANNED)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  program          Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  phase            Phase?                 @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  lessons          Lesson[]
  checklistItems   ChecklistItem[]
  studyGoals       StudyGoal[]
  productMilestone ArchitectureMilestone?

  @@unique([programId, number])
  @@index([phaseId])
  @@map("weeks")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  weekId    String
  category  String
  label     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week     Week                    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  statuses ChecklistItemProgress[]

  @@unique([weekId, category, label])
  @@map("checklist_items")
}

model ChecklistItemProgress {
  id               String    @id @default(cuid())
  userId           String
  checklistItemId  String
  done             Boolean   @default(false)
  note             String?
  evidenceUrl      String?
  installedVersion String?
  reviewNeeded     Boolean   @default(false)
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistItemId])
  @@map("checklist_item_progress")
}

model Lesson {
  id               String        @id @default(cuid())
  weekId           String
  order            Int
  title            String
  objective        String?
  durationMinutes  Int?
  contentMarkdown  String?
  isDemo           Boolean       @default(false)
  status           ContentStatus @default(PLANNED)
  isManuallyEdited Boolean       @default(false)
  aiGeneratedAt    DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  week         Week               @relation(fields: [weekId], references: [id], onDelete: Cascade)
  resources    Resource[]
  completions  LessonCompletion[]
  sessions     StudySession[]
  assessments  Assessment[]
  flashcards   Flashcard[]
  lessonSkills LessonSkill[]
  laboratories Laboratory[]

  @@unique([weekId, order])
  @@map("lessons")
}

model Resource {
  id        String       @id @default(cuid())
  lessonId  String
  title     String
  url       String
  kind      ResourceKind @default(OTHER)
  createdAt DateTime     @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("resources")
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  confidence  Int?
  whatLearned String?
  whatUnclear String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_completions")
}

// ---------------------------------------------------------------------------
// Importação de Curso.md (Fase 2)
// ---------------------------------------------------------------------------

model ImportJob {
  id           String    @id @default(cuid())
  sourceFile   String
  contentHash  String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdCount Int       @default(0)
  updatedCount Int       @default(0)
  skippedCount Int       @default(0)
  report       Json?

  warnings ImportWarning[]

  @@index([contentHash])
  @@map("import_jobs")
}

model ImportWarning {
  id               String  @id @default(cuid())
  importJobId      String
  excerpt          String
  reason           String
  targetEntityHint String?
  needsReview      Boolean @default(true)

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_warnings")
}

// ---------------------------------------------------------------------------
// Aprendizagem (Fase 3): planejamento, sessões, metas, anotações, avaliações,
// flashcards. Progresso agregado é calculado sob demanda via queries (COUNT),
// sem tabela `Progress` própria — ver docs/DECISIONS.md.
// ---------------------------------------------------------------------------

enum GoalStatus {
  OPEN
  DONE
  CANCELLED
}

model StudyPlan {
  id            String   @id @default(cuid())
  userId        String   @unique
  availableDays Int[]    @default([1, 2, 3, 4, 5])
  preferredTime String?
  dailyHours    Float    @default(3.5)
  startDate     DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_plans")
}

model StudyGoal {
  id            String     @id @default(cuid())
  userId        String
  title         String
  targetDate    DateTime?
  relatedWeekId String?
  status        GoalStatus @default(OPEN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedWeek Week? @relation(fields: [relatedWeekId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("study_goals")
}

model StudySession {
  id                 String    @id @default(cuid())
  userId             String
  lessonId           String?
  startedAt          DateTime  @default(now())
  pausedAt           DateTime?
  totalPausedSeconds Int       @default(0)
  endedAt            DateTime?
  durationMinutes    Int?
  focusRating        Int?
  difficultyRating   Int?
  notes              String?
  completedContent   Boolean   @default(false)
  createdAt          DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("study_sessions")
}

enum NoteScope {
  LESSON
  WEEK
  GENERAL
}

enum NoteTemplate {
  SUMMARY
  QUESTION
  DECISION
  TROUBLESHOOTING
  RETROSPECTIVE
  CONCEPT
  COMMAND
}

model Note {
  id              String       @id @default(cuid())
  userId          String
  scopeType       NoteScope    @default(GENERAL)
  scopeId         String?
  template        NoteTemplate @default(SUMMARY)
  title           String
  contentMarkdown String
  tags            String[]     @default([])
  isFavorite      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notes")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Assessment {
  id        String        @id @default(cuid())
  lessonId  String?
  title     String
  status    ContentStatus @default(AVAILABLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lesson        Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions     Question[]
  attempts      AssessmentAttempt[]
  finalForPhase Phase?

  @@map("assessments")
}

model Question {
  id           String       @id @default(cuid())
  assessmentId String
  order        Int
  prompt       String
  type         QuestionType
  explanation  String?

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    AnswerOption[]

  @@unique([assessmentId, order])
  @@map("questions")
}

model AnswerOption {
  id         String  @id @default(cuid())
  questionId String
  order      Int
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("answer_options")
}

model AssessmentAttempt {
  id               String    @id @default(cuid())
  userId           String
  assessmentId     String
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  score            Float?
  answers          Json?
  timeSpentSeconds Int?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId])
  @@map("assessment_attempts")
}

model Flashcard {
  id         String   @id @default(cuid())
  lessonId   String?
  question   String
  answer     String
  difficulty Int      @default(2)
  tags       String[] @default([])
  createdAt  DateTime @default(now())

  lesson  Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  reviews FlashcardReview[]

  @@map("flashcards")
}

model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  flashcardId  String
  reviewedAt   DateTime @default(now())
  quality      Int
  nextReviewAt DateTime
  intervalDays Int      @default(1)
  easeFactor   Float    @default(2.5)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
  @@map("flashcard_reviews")
}

// ---------------------------------------------------------------------------
// Prática profissional (Fase 4): projetos, laboratórios, competências,
// portfólio, AI Labs (empresa fictícia) e gamificação.
// Sem ProjectEvidence/SkillEvidence como tabelas polimórficas separadas — campos
// de evidência ficam diretamente em Project/Laboratory; evidência de competência
// é derivada por query (LessonCompletion via LessonSkill), não persistida.
// Ver docs/DECISIONS.md.
// ---------------------------------------------------------------------------

enum SkillLevel {
  NOT_STARTED
  INTRO
  PRACTICING
  COMPETENT
  ADVANCED
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique
  category    String
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  lessonSkills LessonSkill[]
  userProgress UserSkillProgress[]

  @@map("skills")
}

model LessonSkill {
  lessonId String
  skillId  String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([lessonId, skillId])
  @@map("lesson_skills")
}

model UserSkillProgress {
  id        String     @id @default(cuid())
  userId    String
  skillId   String
  level     SkillLevel @default(NOT_STARTED)
  updatedAt DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skill_progress")
}

model Project {
  id                   String        @id @default(cuid())
  title                String
  problem              String?
  context              String?
  objective            String?
  requirements         String[]      @default([])
  optionalRequirements String[]      @default([])
  deliverables         String[]      @default([])
  acceptanceCriteria   String[]      @default([])
  architectureNotes    String?
  isDemo               Boolean       @default(false)
  status               ContentStatus @default(PLANNED)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  submissions    ProjectSubmission[]
  portfolioItems PortfolioItem[]
  finalForPhase  Phase?

  @@map("projects")
}

model ProjectSubmission {
  id            String     @id @default(cuid())
  userId        String
  projectId     String
  repoUrl       String?
  deployUrl     String?
  decisions     String?
  retrospective String?
  status        GoalStatus @default(OPEN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  codeReviews CodeReview[]

  @@unique([userId, projectId])
  @@map("project_submissions")
}

// Etapa 6: revisão de código assistida por IA (persona Tech Lead, Etapa 2). Histórico completo —
// nunca sobrescreve a revisão anterior, cada solicitação cria uma nova linha.
model CodeReview {
  id           String   @id @default(cuid())
  submissionId String
  score        Float?
  feedback     String
  provider     String
  createdAt    DateTime @default(now())

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("code_reviews")
}

model Laboratory {
  id               String        @id @default(cuid())
  lessonId         String?
  title            String
  objective        String?
  environment      String?
  prerequisites    String[]      @default([])
  instructions     String?
  commands         String?
  expectedResult   String?
  validation       String?
  troubleshooting  String?
  isDemo           Boolean       @default(false)
  isManuallyEdited Boolean       @default(false)
  aiGeneratedAt    DateTime?
  status           ContentStatus @default(PLANNED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lesson      Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  completions LaboratoryCompletion[]

  @@index([lessonId])
  @@map("laboratories")
}

model LaboratoryCompletion {
  id           String   @id @default(cuid())
  userId       String
  laboratoryId String
  completedAt  DateTime @default(now())
  evidenceUrl  String?
  notes        String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  laboratory Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)

  @@unique([userId, laboratoryId])
  @@map("laboratory_completions")
}

model PortfolioItem {
  id               String        @id @default(cuid())
  userId           String
  projectId        String?
  repoUrl          String
  qualityChecklist Json
  status           ContentStatus @default(AVAILABLE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("portfolio_items")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  order       Int
  createdAt   DateTime @default(now())

  @@map("departments")
}

// AI_LABS: linha do tempo fixa da infraestrutura da empresa fictícia AI Labs (importada de
// Curso.md). PRODUCT: Trilha Produto (Etapa 4) — evolução do SaaS "APEX Academy" construído pelo
// aluno, com no máximo 1 marco por semana (`weekId` único). São conceitos distintos na mesma
// tabela para reaproveitar o modelo já existente sem criar um novo domínio — ver
// docs/DECISIONS.md ("AI Labs vs. APEX Academy").
enum MilestoneTrack {
  AI_LABS
  PRODUCT
}

model ArchitectureMilestone {
  id          String         @id @default(cuid())
  track       MilestoneTrack @default(AI_LABS)
  weekId      String?        @unique
  order       Int
  title       String
  description String?
  status      ContentStatus  @default(PLANNED)
  achievedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  week Week? @relation(fields: [weekId], references: [id], onDelete: SetNull)

  @@unique([track, order])
  @@map("architecture_milestones")
}

model Badge {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model ExperienceEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  points    Int
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("experience_events")
}

// ---------------------------------------------------------------------------
// Inteligência Artificial (Fase 5): tutor de IA nível 1.
// AIConversation/AIMessage guardam apenas o histórico de conversa + qual
// provider respondeu, para exibir na UI e para auditoria básica de uso.
// ---------------------------------------------------------------------------

enum AIMessageRole {
  USER
  ASSISTANT
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  context   Json?
  createdAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  provider       String
  tokensApprox   Int?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}
